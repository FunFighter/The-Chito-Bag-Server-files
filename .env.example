# Copy to .env and edit. docker compose reads it automatically.

# --- REQUIRED -------------------------------------------------------------
# Path on your external drive where the world lives. Must already be mounted;
# the compose file refuses to auto-create it so a missing drive fails loudly
# instead of silently writing the world to your root filesystem.
MC_DATA_DIR=/mnt/games/minecraft/chitobag

# You must accept the Minecraft EULA to run a server: https://aka.ms/MinecraftEULA
EULA=false

# --- Ownership ------------------------------------------------------------
# Set to the owner of MC_DATA_DIR on the host so files stay writable from
# outside the container. Check with: id -u ; id -g
PUID=1000
PGID=1000

# --- Server ---------------------------------------------------------------
MC_PORT=25565
# Simple Voice Chat's UDP port. Must be forwarded/allowed separately from the
# game port or voice chat will not work for players.
MC_VOICE_PORT=24454
# Quote any value containing spaces.
MC_MOTD="The Chito Bag Server"
MC_MAX_PLAYERS=20
MC_ONLINE_MODE=true
MC_VIEW_DISTANCE=8
MC_SIMULATION_DISTANCE=6

# --- Memory ---------------------------------------------------------------
# The pack's manifest recommends 10 GB. MC_MEM_LIMIT must exceed MC_XMX.
# Seconds to let the RCON `stop` complete before escalating. Must stay below
# stop_grace_period (180s) in docker-compose.yml.
MC_STOP_TIMEOUT=120

# MC_XMX=auto derives the heap from MC_MEM_LIMIT at startup, leaving the
# larger of 3 GB or 15% for JVM overhead (metaspace for ~190 mods, code cache,
# G1 structures, netty buffers). Set an explicit value like 18G to override.
# MC_XMS defaults to MC_XMX.
MC_XMX=auto
MC_MEM_LIMIT=13g

# --- CPU ------------------------------------------------------------------
# MC_BG_THREADS sets Minecraft's background worker pool (-Dmax.bg.threads) and
# the JVM's ActiveProcessorCount. MC_CPUS caps the container. Keep them equal,
# and leave the host a core or two. 0 = unlimited.
MC_BG_THREADS=
MC_CPUS=0

# --- Build ----------------------------------------------------------------
NEOFORGE_VERSION=21.1.248
# Optional: a CurseForge API key (console.curseforge.com) makes mod downloads
# use the official API instead of the public endpoint. Point this at a file
# containing the key -- keep it OUTSIDE the repo so it cannot be committed.
# Leave as /dev/null to use the public endpoint.
CF_API_KEY_FILE=./docker/cf_api_key.txt
